# ==============================================================================
# DLAS - Digital Legal Aid System
# Environment Variable Template (.env.example)
#
# RULE: DO NOT store real secret values in this file.
# Copy this file to .env and provide your deployment/local secrets.
# .env is strictly ignored by Git.
# ==============================================================================

# Backend Service Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://dlas-legal-aid.vercel.app

# Security & Authentication (Backend Only)
SECRET_KEY=your_secure_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Render PostgreSQL or local SQLite fallback)
# Production (Render): postgresql://user:password@hostname:5432/dbname
# Local Development fallback: sqlite:///./dlas.db
DATABASE_URL=sqlite:///./dlas.db

# AI Intake - Google Gemini (Backend Only - NEVER expose to Frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Telephony & Voice - Twilio (Backend Only - NEVER expose to Frontend)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VOICE_LANGUAGE=bn-BD

# Demo Identity Adapter (Simulated NID Service - no government API claimed)
NID_SERVICE_MODE=mock

# Frontend Public Environment Variables (Vercel)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws
